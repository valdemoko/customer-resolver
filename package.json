{
  "name": "alzado",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de publicidad en ciudades 3D. Catálogo de ciudades + visor de mapas con parcelas publicitarias.",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit && pnpm run test:pipeline",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:pipeline": "node --test \"data-pipeline/test/*.test.mjs\"",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@neondatabase/serverless": "^1.2.0",
    "@opennextjs/cloudflare": "^1.20.10",
    "clsx": "^2.1.1",
    "earcut": "^3.2.4",
    "geist": "1.7.2",
    "lucide-react": "1.54.0",
    "next": "16.4.0",
    "pbf": "^5.1.2",
    "pmtiles": "4.5.0",
    "polygon-clipping": "^0.15.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.4.1",
    "three": "^0.186.1",
    "three-mesh-bvh": "0.9.9",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/earcut": "^3.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@types/three": "^0.186.0",
    "playwright-core": "^1.64.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "wrangler": "^4.149.0"
  }
}
