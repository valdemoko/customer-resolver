# ──────────────────────────────────────────────────────────────────────────────
# Consumer Resolver — environment template
#
# Copy to .env.local for development. NEVER commit .env.local (see .gitignore).
# All values below are PLACEHOLDERS, not secrets. Phases that consume each
# variable are noted; unset optional variables are fine until that phase.
# ──────────────────────────────────────────────────────────────────────────────

# Public site URL (used for metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Log level: debug | info | warn | error (default: info in production)
LOG_LEVEL=debug

# ── Fase 1: Database (PostgreSQL / Neon) ──────────────────────────────────────
# Example placeholder: postgresql://user:password@localhost:5432/consumer_resolver
DATABASE_URL=

# ── Fase 5: Object storage (Cloudflare R2, S3-compatible) ────────────────────
R2_ACCOUNT_ID=
R2_BUCKET_DOCUMENTS=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Fase 6: AI providers (server-only; keys NEVER reach the client) ──────────
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Fase 6: AI orchestration tuning (server-side only, all optional)
# AI_DEFAULT_PROVIDER=groq
# AI_DEFAULT_MODEL=llama-3.1-8b-instant
# AI_MAX_RETRIES=2
# AI_TIMEOUT_MS=30000

# ── Fase 2: Transactional email (Resend) ─────────────────────────────────────
RESEND_API_KEY=
