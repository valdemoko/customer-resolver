# ---------------------------------------------------------------------------
# Copia este archivo a `.env.local` y rellena lo que tengas.
# Nada de esto es obligatorio para arrancar el catálogo (Fase A).
# ---------------------------------------------------------------------------

# --- Aplicación -------------------------------------------------------------
# Origen público de la app. Se usa para canonical, OG, callbacks de auth y
# para que el servidor NUNCA derive el origen de la cabecera Host.
APP_ORIGIN=http://localhost:3000

# --- Base de datos (Fase D) -------------------------------------------------
# PostgreSQL con PostGIS. Neon / Supabase / local.
# Sin esta variable, la app funciona con el registro de ciudades en código.
DATABASE_URL=

# --- Autenticación (Fase D) -------------------------------------------------
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email transaccional (Fase D) -------------------------------------------
EMAIL_SERVER=
EMAIL_FROM=

# --- Almacenamiento de objetos: PMTiles, miniaturas, subidas (Fase B/D) -----
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Límite de frecuencia (Fase D) ------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Turnstile (Fase D) -----------------------------------------------------
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Observabilidad (Fase D) ------------------------------------------------
SENTRY_DSN=

# ---------------------------------------------------------------------------
# STRIPE — capa preparada y DESACTIVADA.
# El interruptor manda: con PURCHASES_ENABLED=false la API rechaza crear
# pedidos y la interfaz muestra "Compras próximamente". No existe un modo
# "simulado" que aparente una compra real.
# ---------------------------------------------------------------------------
PURCHASES_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
