{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Debe coincidir con el Worker que ya existe en la cuenta de Cloudflare (customer-resolver):
  // Workers Builds lo toma del panel y el self-reference de abajo tiene que apuntar al mismo.
  "name": "customer-resolver",
  "workers_dev": false,
  "preview_urls": false,
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "customer-resolver"
    }
  ],
  "observability": { "enabled": true }
}
